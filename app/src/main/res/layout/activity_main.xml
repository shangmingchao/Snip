<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <Button
        android:id="@+id/crop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/ratioWidth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints="android.view.autofill.hint.width"
        android:gravity="center"
        android:hint="@string/ratio_width"
        android:inputType="number"
        android:minWidth="50dp"
        app:layout_constraintBottom_toBottomOf="@id/crop"
        app:layout_constraintStart_toEndOf="@id/crop"
        app:layout_constraintTop_toTopOf="@id/crop" />

    <TextView
        android:id="@+id/ratio_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ratio_divider"
        android:textSize="14sp"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/ratioWidth"
        app:layout_constraintTop_toTopOf="@id/ratioWidth"
        app:layout_constraintBottom_toBottomOf="@id/ratioWidth"/>

    <EditText
        android:id="@+id/ratioHeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints="android.view.autofill.hint.height"
        android:gravity="center"
        android:hint="@string/ratio_height"
        android:inputType="number"
        android:minWidth="50dp"
        app:layout_constraintBottom_toBottomOf="@id/crop"
        app:layout_constraintStart_toEndOf="@id/ratio_divider"
        app:layout_constraintTop_toTopOf="@id/crop" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/crop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/crop" />
</androidx.constraintlayout.widget.ConstraintLayout>
